# Cal.com MCP Server - Environment Variables
# Copy to .env and fill in. Never commit .env.

# =============================================================================
# HTTP server (VPS / docker compose)
# =============================================================================

# Host port nginx proxies to (docker binds 127.0.0.1:HOST_PORT → container 8080).
# 8102 on the mcp.techmavie.digital VPS (8100 = mcp-forgejo, 8101 is taken too).
HOST_PORT=8102

# Admin key: enables self-hosted /mcp header mode and the /analytics endpoints.
# Generate with: openssl rand -hex 32
MCP_API_KEY=

# Hosted key-service mode (/mcp/usr_...). Set BOTH or NEITHER — the server refuses to start with only one.
# KEY_SERVICE_URL is the FULL resolve URL. The container must be on the external mcp-network.
# KEY_SERVICE_TOKEN is this server's token from INTERNAL_SERVER_TOKENS in mcp-key-service ("calcom:<token>").
# KEY_SERVICE_URL=http://mcp-key-service:8090/internal/resolve
# KEY_SERVICE_TOKEN=

# Public path prefix behind nginx (used in the server card and endpoint listing)
PUBLIC_BASE_PATH=/calcom

# CORS allowlist (comma-separated). Empty or * = allow all.
ALLOWED_ORIGINS=

# API URLs that resolve to private IPs are blocked (SSRF protection).
# List hostnames here to allow them, e.g. an API v2 container reached over a private network.
ALLOW_PRIVATE_CALCOM_HOSTS=

# Upstream request timeout (ms)
CALCOM_TIMEOUT_MS=30000

# Debugging (keys are masked in logs)
MCP_TRACE_HTTP=false
ENABLE_MCP_DIAGNOSTICS=false

# Firebase usage analytics (optional). The credentials directory must contain
# firebase-service-account.json; it is mounted read-only at /app/.credentials.
FIREBASE_CREDENTIALS_DIR=/opt/mcp-servers/.credentials
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# =============================================================================
# CLI / stdio mode and `npm run live-check` (not used by the HTTP server)
# =============================================================================

# Cal API key (Cal → Settings → Developer → API Keys), starts with cal_
CALCOM_API_KEY=
# API v2 URL of a self-hosted instance; leave empty for Cal.com Cloud (https://api.cal.com/v2)
CALCOM_API_URL=https://book.example.com/api/v2
# read (default) | bookings | full — live-check always forces read
# CALCOM_ACCESS=read
